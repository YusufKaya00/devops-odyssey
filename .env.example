# DevOps Odyssey Config Template
# Copy this file to '.env' in this directory and populate with your database credentials.

# PostgreSQL connection string (e.g. Supabase, Neon, AWS RDS, Local PG instance)
# For Supabase, go to Project Settings -> Database -> Connection string -> URI
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

